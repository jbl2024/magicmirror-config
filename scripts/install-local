#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
version="${MM_VERSION:-$(tr -d '[:space:]' < "$repo_root/VERSION")}"
install_root="${MAGICMIRROR_INSTALL_ROOT:-$HOME/.local/share/magicmirror}"
env_file="${MAGICMIRROR_ENV_FILE:-$HOME/.config/magicmirror/config.env}"
deploy_id="v${version}-$(date -u +%Y%m%dT%H%M%SZ)"
release_dir="$install_root/releases/$deploy_id"
current_link="$install_root/current"
previous_link="$install_root/previous"
activated=0

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

cleanup_failed_release() {
  if [[ "$activated" -eq 0 && -d "$release_dir" ]]; then
    case "$release_dir" in
      "$install_root"/releases/*) rm -rf -- "$release_dir" ;;
    esac
  fi
}

trap cleanup_failed_release ERR
umask 077

command -v git >/dev/null || fail "git is required"
command -v node >/dev/null || fail "node is required"
command -v npm >/dev/null || fail "npm is required"
[[ -r "$env_file" ]] || fail "missing secrets file: $env_file"

node -e '
const [major, minor, patch] = process.versions.node.split(".").map(Number);
const supported = major >= 24 || (major === 22 && (minor > 22 || (minor === 22 && patch >= 2)));
if (!supported) {
  console.error(`MagicMirror 2.37 requires Node >=22.22.2 <23 or >=24; found ${process.versions.node}`);
  process.exit(1);
}
'

while IFS= read -r variable; do
  [[ -z "$variable" ]] && continue
  if ! grep -Eq "^${variable}=.+" "$env_file"; then
    fail "missing or empty ${variable} in $env_file"
  fi
done < <(sed -n 's/^\([A-Z][A-Z0-9_]*\)=.*$/\1/p' "$repo_root/.env.example")

mkdir -p -- "$install_root/releases"
git clone \
  --branch "v$version" \
  --depth 1 \
  https://github.com/MagicMirrorOrg/MagicMirror.git \
  "$release_dir"

(
  cd -- "$release_dir"
  node --run install-mm
)

while IFS='|' read -r name repository commit; do
  [[ -z "$name" || "$name" == \#* ]] && continue
  module_dir="$release_dir/modules/$name"
  git init --quiet "$module_dir"
  git -C "$module_dir" remote add origin "$repository"
  git -C "$module_dir" fetch --quiet --depth 1 origin "$commit"
  git -C "$module_dir" checkout --quiet --detach FETCH_HEAD

  if [[ -f "$module_dir/package-lock.json" ]]; then
    npm --prefix "$module_dir" ci --omit=dev --ignore-scripts
  elif [[ -f "$module_dir/package.json" ]]; then
    npm --prefix "$module_dir" install --omit=dev --ignore-scripts
  fi

  # Some modules keep their runtime entry points in src/ and materialize them
  # with their development installer after dependencies are present.
  if [[ -f "$module_dir/src/$name.js" ]] &&
    npm --prefix "$module_dir" pkg get scripts.dev | grep -Fq '"'; then
    npm --prefix "$module_dir" run dev
  fi
done < "$repo_root/modules.lock"

install -m 0600 "$repo_root/data/config/config.js" "$release_dir/config/config.js"
install -m 0644 "$repo_root/data/config/custom.css" "$release_dir/config/custom.css"
ln -s -- "$env_file" "$release_dir/config/config.env"

(
  cd -- "$release_dir"
  node --run config:check
)

if [[ -L "$current_link" ]]; then
  old_release="$(readlink "$current_link")"
  ln -sfn -- "$old_release" "$previous_link"
fi

ln -sfn -- "$release_dir" "$install_root/current.new"
mv -Tf -- "$install_root/current.new" "$current_link"
activated=1
trap - ERR

if command -v pm2 >/dev/null; then
  MAGICMIRROR_INSTALL_ROOT="$install_root" \
    "$repo_root/scripts/restart"
else
  printf 'MagicMirror installed at %s\n' "$release_dir"
  printf 'PM2 is not installed; start it with: cd %q && npm start\n' "$current_link"
fi
