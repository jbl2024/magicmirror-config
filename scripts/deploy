#!/usr/bin/env bash
set -Eeuo pipefail

target="${MIRROR_TARGET:-jerome@mirror.local}"
remote_repo="${MIRROR_CONFIG_REPO:-magicmirror-config}"

[[ "$remote_repo" =~ ^[A-Za-z0-9._/-]+$ ]] || {
  printf 'invalid remote repository path\n' >&2
  exit 1
}

ssh "$target" "cd -- $remote_repo && git pull --ff-only && ./scripts/install-local"
